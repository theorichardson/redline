{
  "name": "redline",
  "version": "1.1.4",
  "description": "Browser extension for debugging web layout issues with DOM layer navigation and LLM-optimized context extraction",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "docs:dev": "live-server docs --port=8792 --watch=docs --no-browser"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "live-server": "^1.2.2",
    "sharp": "^0.34.4",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
